#%PAM-1.0
# MiMoAuth: password verification service for mimoauthd.
# Installed by scripts/install.sh; safe to remove (daemon falls back
# to the "su" service when this file is absent).
auth      include   system-local-login
account   include   system-local-login
password  include   system-local-login
session   include   system-local-login
