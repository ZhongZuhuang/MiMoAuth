[Unit]
Description=MiMoAuth authorization daemon (polkit-style auth for MiMo Desktop)
Documentation=file://%h/Project/MiMoAuth/REQUIREMENTS.md
After=dbus.socket
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/mimoauthd
Restart=on-failure
RestartSec=2
# Keep the daemon light: no core dumps, tight umask.
LimitCORE=0
UMask=0077

[Install]
# default.target: boot (agent/CLI usable even without a GUI session)
# graphical-session.target: every login re-activates the daemon after a
# session stop (PartOf above) — zero manual steps after reboot/logout.
WantedBy=default.target graphical-session.target
